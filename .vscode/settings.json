{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.workingDirectories": [{ "directory": "svelte", "changeProcessCWD": true }],
  "prettier.requireConfig": true,
  "typescript.tsdk": "svelte/node_modules/typescript/lib",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "go.lintTool": "golangci-lint",
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/storybook-static": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/storybook-static": true
  },
  "explorer.fileNesting.patterns": {
    "*.svelte": "${capture}.stories.svelte, ${capture}.test.ts, ${capture}-harness.test.svelte",
    "*.ts": "${capture}.test.ts",
    "*.go": "${capture}_test.go",
    "package.json": "package-lock.json",
    "go.mod": "go.sum"
  }
}
