# Público: quem protege o hub é o login (Neon Auth), conferido pelo Go.
hub.docs.vinicius-gpl.com {
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # SAMEORIGIN e não DENY: a galeria mostra a prévia do artefato (/a/...) num iframe.
        X-Frame-Options "SAMEORIGIN"
    }

    # Serviço do Swarm da stack hetzner_artifact-docs, pela rede edge.
    reverse_proxy hetzner_artifact-docs_app:3010 {
        header_up X-Real-IP {remote}
    }

    encode zstd gzip

    log {
        output file /data/artifact-docs-access.log
        format json
    }
}
