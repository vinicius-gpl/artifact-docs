# Variáveis do client. Este arquivo é versionado; o `.env` ao lado nunca.
#
# TUDO AQUI É PÚBLICO: o que tem prefixo `VITE_` entra no bundle, e qualquer pessoa que
# abrir o site consegue ler. Chave de API, senha, token: NUNCA aqui. Segredo mora no
# `src-go/.env`, e a separação por arquivo é o que torna o engano impossível.
#
# Nada além da porta é obrigatório em desenvolvimento: a web fala com `/api` no mesmo host e
# o Vite encaminha para o Go.

# Porta local da interface.
VITE_PORT=5010

# Porta do server.
VITE_API_PORT=3010

# Endereço da API no build de produção. Vazio = mesma origem (o binário Go serve a SPA).
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Modo mock — a tela sem o Go
# ─────────────────────────────────────────────────────────────────────────────
# `true`: toda chamada a /api é respondida por src/lib/api/mock-server.ts, com dados de
# mentira em memória. O `mise run dev` já liga por padrão; para falar com o Go de verdade:
#   VITE_API_MOCKS=false mise run dev
VITE_API_MOCKS=false
