# Variáveis da API (Go). Este arquivo é versionado; o `.env` ao lado nunca.
#
# Em desenvolvimento o mise carrega o `.env` daqui (ver mise.toml); em produção quem as
# entrega é o systemd. Segredo (banco, R2, chaves) mora só no `.env`, nunca aqui.

# Porta da API. A SPA encaminha /api e /a para cá (VITE_API_PORT em svelte/.env.example).
API_PORT=3010

# development (padrão) · test · production. Em "test" (o e2e) toda requisição entra como o
# usuário de teste, sem Neon Auth — e o processo se recusa a subir se NEON_AUTH_JWKS_URL
# estiver preenchida junto.
APP_ENV=development

# Banco (Neon) — use o endpoint POOLED (o host com "-pooler"). Sem ela, o servidor sobe sem
# banco e as rotas de dados respondem 503. As migrations rodam sozinhas ao subir.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Login (Neon Auth) — ver docs/auth.md. Sem NEON_AUTH_JWKS_URL o login fica desligado.
# ─────────────────────────────────────────────────────────────────────────────
NEON_AUTH_URL=          # Auth → URL do endpoint (a mesma da VITE_NEON_AUTH_URL)
NEON_AUTH_JWKS_URL=     # Auth → JWKS URL
AUTH_ALLOWED_EMAILS=    # o seu e-mail; vários separados por vírgula

# ─────────────────────────────────────────────────────────────────────────────
# Arquivos (Cloudflare R2, API S3) — R2 → Manage API tokens. Os quatro juntos, ou nenhum:
# sem eles, publicar e abrir artefato respondem 503.
# ─────────────────────────────────────────────────────────────────────────────
R2_ENDPOINT=            # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Assina os links dos artefatos privados (32+ caracteres aleatórios: openssl rand -hex 32).
# Vazio, o processo sorteia um ao subir, e os links privados param de valer a cada deploy.
ARTIFACT_LINK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# E2E da SPA (Playwright) e testes do SQL — só o banco. O e2e roda com APP_ENV=test, que
# entra como o usuário de teste sem conta no Neon Auth (docs/auth.md). Use um banco (ou
# branch do Neon) só de teste: as migrations rodam nele e os testes criam e apagam dados.
# ─────────────────────────────────────────────────────────────────────────────
TEST_DATABASE_URL=
