# Variáveis da API (Go). Este arquivo é versionado; o `.env` ao lado nunca.
#
# Em desenvolvimento o mise carrega o `.env` daqui (ver mise.toml); em produção quem as
# entrega é o systemd. Segredo (banco, R2, chaves) mora só no `.env`, nunca aqui.

# Porta da API. A SPA encaminha /api para cá (VITE_API_PORT em svelte/.env.example).
API_PORT=3010

# ─────────────────────────────────────────────────────────────────────────────
# E2E da SPA (Playwright) — conta de teste criada no painel do Neon Auth
# ─────────────────────────────────────────────────────────────────────────────
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
TEST_DATABASE_URL=
